<Window x:Class="DiskAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiskAnalyzer"
        mc:Ignorable="d"
        Title="Анализ дисков" Height="450" Width="700"
        WindowStartupLocation="CenterScreen"
        Icon="Icons/drive.ico">
    
    <Window.Resources>
        <local:PercentToColorConverter x:Key="PercentToColorConverter"/>
        
        <DataTemplate x:Key="driveTemplate">
            <Border Background="White" 
                    CornerRadius="6" 
                    Padding="12" 
                    Margin="0,0,0,8"
                    BorderBrush="#DDD"
                    BorderThickness="1">
                
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                   Text="Диск:" 
                                   FontSize="16" 
                                   Margin="0,0,8,0"/>
                        
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding DriveName}" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"/>
                        
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding TotalSize, StringFormat={}{0:F2} ГБ}" 
                                   FontSize="12" 
                                   Foreground="Gray"/>
                    </Grid>
                    
                    <ProgressBar Value="{Binding UsagePercent}" 
                                 Height="12" 
                                 Foreground="{Binding UsagePercent, Converter={StaticResource PercentToColorConverter}}"
                                 Background="#E8E8E8"
                                 Margin="0,0,0,6"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Занято: "/>
                        <TextBlock Text="{Binding UsedSize, StringFormat={}{0:F2} ГБ}" Foreground="#1976D2"/>
                        <TextBlock Text="  |  "/>
                        <TextBlock Text="Свободно: "/>
                        <TextBlock Text="{Binding FreeSize, StringFormat={}{0:F2} ГБ}" Foreground="#388E3C"/>
                        <TextBlock Text="  |  "/>
                        <TextBlock Text="{Binding UsagePercent, StringFormat={}{0}%}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding UpdateCommand}"/>
    </Window.InputBindings>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Диски" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text=" (F5 - обновить)" FontSize="12" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        
        <ListBox Grid.Row="1" 
                 ItemsSource="{Binding Drives}"
                 ItemTemplate="{StaticResource driveTemplate}"
                 BorderThickness="0"
                 Background="Transparent"/>
    </Grid>
</Window>