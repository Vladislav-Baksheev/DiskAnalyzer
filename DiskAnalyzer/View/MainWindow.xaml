<Window x:Class="DiskAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiskAnalyzer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate x:Key="driveTemplate">
            <StackPanel Margin="3">
                <TextBlock 
                    Text="{Binding Path=DriveName}" 
                    FontSize="12"
                    FontWeight="SemiBold"/>
                <TextBlock 
                    Text="{Binding Path=TotalSize, StringFormat=Всего: {0} ГБ}" 
                    FontSize="12"
                    FontWeight="SemiBold"/>
                <TextBlock 
                    Text="{Binding Path=UsedSize, StringFormat=Использовано: {0} ГБ}" 
                    FontSize="12"
                    FontWeight="SemiBold"/>
                <TextBlock 
                    Text="{Binding Path=FreeSize, StringFormat=Свободно: {0} ГБ}" 
                    FontSize="12"
                    FontWeight="SemiBold"/>
                
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <ListBox 
            Margin="3"
            ItemsSource="{Binding Path=Drives}"
            ItemTemplate="{StaticResource driveTemplate}">
        </ListBox>
    </Grid>
</Window>
                                                                                                                   